# Copy to .env and adjust. Never commit .env.
# Phase 1 needs NO exchange credentials: only public market data is used.

# Local zero-setup default (SQLite). For PostgreSQL (recommended for real data):
# FUNDPILOT_DATABASE_URL=postgresql+psycopg://fundpilot:fundpilot@localhost:5432/fundpilot
FUNDPILOT_DATABASE_URL=sqlite:///./data/fundpilot.sqlite

# Execution mode. Only dry_run exists in Phase 1; live execution is not implemented.
FUNDPILOT_EXECUTION_MODE=dry_run

# Funding symbols to collect (JSON list). fUST = Bitfinex code believed to be Tether USDt
# (verify against the official Bitfinex docs before relying on it).
FUNDPILOT_SYMBOLS=["fUST"]

FUNDPILOT_COLLECT_INTERVAL_SECONDS=60
FUNDPILOT_BITFINEX_REQUESTS_PER_MINUTE=15
FUNDPILOT_BITFINEX_MAX_RETRIES=3

# Unit assumptions that MUST be confirmed against live responses / official docs:
FUNDPILOT_BITFINEX_FUNDING_STATS_FRR_SCALE=365
FUNDPILOT_BITFINEX_CANDLE_PERIOD_SPEC=a30:p2:p30

# Retention in days (0 = keep forever). Pruning is always dry-run unless --confirm.
FUNDPILOT_RETENTION_BOOK_SNAPSHOTS_DAYS=90

# Optional OpenAI-compatible LLM for `fundpilot agent` (leave unset for deterministic mode).
# FUNDPILOT_LLM_BASE_URL=https://your-provider.example/v1
# FUNDPILOT_LLM_MODEL=your-model
# FUNDPILOT_LLM_API_KEY=
